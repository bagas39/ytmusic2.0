<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F"
    android:orientation="vertical">

    <!-- Layar YouTube Music (Murni XML untuk stabilitas penuh WebView & Background Bypass) -->
    <com.example.ytmusic2.KeepAliveWebView
        android:id="@+id/webViewYoutubeMusic"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Panel Kontrol & Offline Player Modern (Jetpack Compose Material 3) -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeControlDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Lingkaran Piringan Utama: Gradasi YT Music Red ke Dark Berry/Slate -->
    <path android:pathData="M54,26 A28,28 0 1,1 54,82 A28,28 0 1,1 54,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="26"
                android:endX="78"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFF1E42" />
                <item android:offset="0.55" android:color="#FFB80028" />
                <item android:offset="1.0" android:color="#FF1A1F2C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cincin Tepi Luar (Outer Rim): Fusion Merah YT ke Hijau Open Source -->
    <path
        android:pathData="M54,26 A28,28 0 1,1 54,82 A28,28 0 1,1 54,26 Z"
        android:strokeWidth="1.8"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="26"
                android:endX="82"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFF5252" />
                <item android:offset="0.5" android:color="#40FFFFFF" />
                <item android:offset="1.0" android:color="#FF00E676" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cincin Dalam Bergaya Logo OSI (Terbuka di Bawah) dengan Gradasi Hijau-Cyan -->
    <path
        android:pathData="M41.4,72.0 A22,22 0 1,1 66.6,72.0"
        android:strokeWidth="3.0"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="32"
                android:startY="32"
                android:endX="76"
                android:endY="76"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.45" android:color="#FF00E5FF" />
                <item android:offset="1.0" android:color="#FF00E676" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Titik Indikator Open Source di Celah Bawah Cincin -->
    <path
        android:fillColor="#FF00E676"
        android:pathData="M54,73.5 A2,2 0 1,1 54,77.5 A2,2 0 1,1 54,73.5 Z" />

    <!-- Ikon Play di Titik Tengah dengan Sentuhan Gradasi Halus -->
    <path android:pathData="M47,45 C47,43.3 48.8,42.3 50.3,43.2 L64.3,52.2 C65.7,53.0 65.7,55.0 64.3,55.8 L50.3,64.8 C48.8,65.7 47,64.7 47,63 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="47"
                android:startY="43"
                android:endX="65"
                android:endY="65"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="1.0" android:color="#FFE0F7FA" />
            </gradient>
        </aapt:attr>
    </path>
</vector>